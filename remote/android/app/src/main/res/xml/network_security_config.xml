<?xml version="1.0" encoding="utf-8"?>
<!-- The camera serves plain http:// and ws:// on the home LAN (no TLS), so cleartext is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
