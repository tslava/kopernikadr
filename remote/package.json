{
  "name": "kopernikadr-remote",
  "version": "0.1.0",
  "private": true,
  "description": "Kopernikadr native remote for the tablet: Next.js static export wrapped in Capacitor (Android)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "cap:sync": "cap sync android",
    "android:debug": "npm run build && npm run cap:sync && cd android && ./gradlew-jbr :app:assembleDebug",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@kopernikadr/remote-core": "0.1.0",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/file-transfer": "2.0.6",
    "@capacitor/filesystem": "8.1.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
